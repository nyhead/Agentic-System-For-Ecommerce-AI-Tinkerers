# Proposed names. Match these to the app's actual server-side adapter.
# Copy to .env.local and populate locally; never commit real values.
SHOPIFY_STORE_DOMAIN=
# Admin API token of the store's app. It needs the scopes write_products,
# read_publications and write_publications: creating the draft needs the first,
# publishing to the Online Store needs the other two.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# app/tools/shopify.py defaults to 2026-10 when this is empty.
SHOPIFY_API_VERSION=2026-10
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional; not required for CI or the first deployment.
# Apify API token (Console > Settings > API & Integrations), not the promo code. Server-side only.
APIFY_TOKEN=
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=
# Market research (app/agents/research.py). All optional; defaults shown.
# Sources: ebay-sold (caffein.dev/ebay-sold-listings), ebay-active (automation-lab/ebay-scraper).
RESEARCH_SOURCES=ebay-sold,ebay-active
RESEARCH_MAX_RESULTS_PER_SOURCE=10
# Apify stops each run's paid events at this cap (maxTotalChargeUsd).
RESEARCH_MAX_CHARGE_USD_PER_RUN=0.20
RESEARCH_RUN_TIMEOUT_SECS=180
RESEARCH_RUN_MEMORY_MB=1024
RESEARCH_SOLD_DAYS=90
RESEARCH_CACHE_TTL_HOURS=24
# A writable JSON file that keeps research jobs and Apify run IDs across restarts.
RESEARCH_STATE_PATH=
